{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=getir_replica;Username=postgres;Password=YOUR_POSTGRES_PASSWORD",
    "Redis": "localhost:6379"
  },
  "Google": {
    "ClientId": "YOUR_GOOGLE_OAUTH_CLIENT_ID"
  },
  "Jwt": {
    "Secret": "CHANGE_THIS_TO_A_32_CHAR_MINIMUM_SECRET_KEY",
    "Issuer": "GetirReplicaAPI",
    "Audience": "GetirReplicaClient",
    "ExpiryMinutes": 480
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "GetirReplica.API",
      "Environment": "Production"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "OpenTelemetry": {
    "ServiceName": "GetirReplica.API",
    "OtlpEndpoint": "http://localhost:4317"
  }
}

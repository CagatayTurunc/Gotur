      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "rate(microsoft_aspnetcore_hosting_failed_requests{job=\"gotur-api\"}[5m]) / rate(microsoft_aspnetcore_hosting_total_requests{job=\"gotur-api\"}[5m])",
          "legendFormat": "5xx oranı"
        }
